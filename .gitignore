# ── Build artifacts / local backups — never under source control ──────────────
/backup/
/build/
/out/
# snc/mac/build/ isn't covered by /build/ above (that only matches the
# repo-root build dir) -- a stale DMG got committed here once and was
# silently re-uploaded for months by deploy.sh's now-fixed path bug.
snc/mac/build/

# ── Go binaries ──────────────────────────────────────────────────────────────
*.exe
*.exe~
*.zip
*.tar.gz

# Built Linux binaries (produced by deploy/build.sh)
snc-arbiter/snc-arbiter
snc-arbiter/snc-arbiter-linux
snc-control/snc-control
snc-exit/snc-exit
snc-exit/snc-exit.linux
snc-core/snc-core
snc-probe-android
snc-probe-android-x86

# deploy/bin is managed by build scripts
deploy/bin/*
!deploy/bin/.gitignore

# ── Android ──────────────────────────────────────────────────────────────────
# android-client/ was the pre-refactor path (see snc/ move); kept so history
# stays ignored consistently. snc/android/ is the current one.
android-client/.gradle/
android-client/app/.cxx/
android-client/app/build/
android-client/local.properties
snc/android/.gradle/
snc/android/app/.cxx/
snc/android/app/build/
snc/android/local.properties
*.apk
*.aab

# WebView2 runtime profile (cookies, shader cache, cert revocation lists, etc.)
# generated by snc-probe's third-party auth webview — never source, thousands of files.
snc/win/cmd/snc-probe/webview_profile/

# SncInstaller (.NET) build output — self-contained publish alone is ~145MB
# of runtime DLLs, never source.
snc/win/Installer/SncInstaller/bin/
snc/win/Installer/SncInstaller/obj/

# Stray deploy.bat output redirect
snc/win/deploy_out.log

# ── macOS client ─────────────────────────────────────────────────────────────
macos-client/build/
build-macos/

# ── Win client ───────────────────────────────────────────────────────────────
win-client/internal/wintun/wintun.dll

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
tools/.env
Hetzner.md

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Xcode (per-user IDE state, not project config) ────────────────────────────
xcuserdata/
*.xcuserstate
.idea/
*.iml
