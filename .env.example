# Copy to .env and fill in real values.
# .env is gitignored — never commit credentials.

# Android build: keystore password for signing the release APK
# (see snc/android/build.bat). Prompted interactively if unset.
SNC_SIGN_PASSWORD=

# macOS build: codesign identity and notarization team ID
# (see snc/mac/build.sh). Both are required — set them to your own
# Apple Developer "Developer ID Application" identity and team ID.
CERT_ID=
APPLE_TEAM_ID=
