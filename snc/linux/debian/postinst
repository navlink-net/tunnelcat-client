#!/bin/sh
set -e

# System group gating access to the daemon's CLI control socket
# (/var/lib/shortnerdcat/cli.sock) -- membership, not mere local-machine
# presence, is what lets `shortnerdcat status/connect/disconnect/key` work
# without root. Add a desktop user to it with: usermod -aG shortnerdcat $USER
# (2026-09 security review #2: the socket used to be world-accessible with
# no group at all).
if command -v addgroup >/dev/null 2>&1; then
    addgroup --system shortnerdcat 2>/dev/null || true
elif command -v groupadd >/dev/null 2>&1; then
    groupadd -r shortnerdcat 2>/dev/null || true
fi

# Ensure data and log directories exist with correct permissions. 0710: the
# daemon (root) has full access; shortnerdcat-group members can traverse
# into the directory to reach cli.sock (which the daemon itself chowns to
# this group at startup) but cannot list its contents.
mkdir -p /var/lib/shortnerdcat
mkdir -p /var/lib/shortnerdcat/logs
chgrp shortnerdcat /var/lib/shortnerdcat 2>/dev/null || true
chmod 0710 /var/lib/shortnerdcat
chmod 0755 /var/lib/shortnerdcat/logs

# Binary must be owned by root and not world-writable for pkexec to accept it.
chown root:root /usr/bin/shortnerdcat
chmod 0755 /usr/bin/shortnerdcat

# Register navlink:// URI scheme handler.
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications || true
fi

# Reload systemd and enable+start the service.
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload
    systemctl enable shortnerdcat.service || true
    systemctl start  shortnerdcat.service || true
fi
