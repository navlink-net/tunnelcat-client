<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Outbound network connections (SOCKS, control, relay). -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Inbound connections for the local SOCKS5 listener. -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Hardened runtime: allow JIT (not needed now, kept for future use). -->
    <!-- <key>com.apple.security.cs.allow-jit</key><true/> -->

    <!-- Hardened runtime: allow dyld environment variables. -->
    <!-- <key>com.apple.security.cs.allow-dyld-environment-variables</key><true/> -->
</dict>
</plist>
